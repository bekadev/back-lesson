{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    //    "**/*.test.ts"
    // "__tests__/**/*"
  ],
  "exclude": [
    "node_modules"
    //    "**/*.test.ts"
    //    "__tests__/**/*"
  ]
}